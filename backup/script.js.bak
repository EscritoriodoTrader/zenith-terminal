let chartData, chartDataMap, rawTrades, processedTradeIds, externalLastPrice, hasRealData, priceMax, priceMin, horizontalScroll, visibleCandles;
let needsHistoryRedraw = true;
let needsScaleRedraw = true;
let needsAutoScale = true;
let lastPriceRange = null;

function switchChannel(channel) {
    if (!states[channel]) return;

    if (chartData !== undefined && states[activeChannel]) {
        states[activeChannel].priceMax = priceMax;
        states[activeChannel].priceMin = priceMin;
        states[activeChannel].horizontalScroll = horizontalScroll;
        states[activeChannel].visibleCandles = visibleCandles;
        states[activeChannel].externalLastPrice = externalLastPrice;
        states[activeChannel].hasRealData = hasRealData;
    }

    activeChannel = channel;
    const s = states[channel];

    chartData = s.chartData;
    chartDataMap = s.chartDataMap;
    rawTrades = s.rawTrades;
    processedTradeIds = s.processedTradeIds;
    externalLastPrice = s.externalLastPrice;
    hasRealData = s.hasRealData;
    priceMax = s.priceMax;
    priceMin = s.priceMin;
    horizontalScroll = s.horizontalScroll;
    visibleCandles = s.visibleCandles;

    needsHistoryRedraw = true;
    needsScaleRedraw = true;
    if (hasRealData) autoScale();
    draw();
}

switchChannel('T&T0');

