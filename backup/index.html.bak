<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Escritório do Trader Gráfico v8.9.4</title>
    <link rel="stylesheet" href="style.css">
    <link rel="icon" href="data:,">
</head>

<body>
    <div id="terminal">
        <!-- CABEÇALHO (TOP BAR) -->
        <header class="top-bar" id="main-header">
            <!-- CONTAINER DE ATIVOS (INFORMATIVOS) -->
            <div id="assets-container" class="assets-tabs">
                <div class="informativo active" data-channel="T&T0">
                    <span class="close-pill">×</span>
                    <span class="asset-name">--- <span class="tf-display">---</span></span>
                    <span id="variation-0" class="asset-variation" style="opacity: 0.5;">---%</span>
                </div>
                <div class="informativo" data-channel="T&T1">
                    <span class="close-pill">×</span>
                    <span class="asset-name">--- <span class="tf-display">---</span></span>
                    <span id="variation-1" class="asset-variation" style="opacity: 0.5;">---%</span>
                </div>
                <button id="btn-add-asset" class="add-btn">+</button>
            </div>

            <!-- BOTÃO VOLTAR AO PRESENTE (SNAP BACK) -->
            <div id="snap-back" class="snap-back-btn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                    stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
            </div>
        </header>

        <main class="chart-container">
            <!-- MENU LATERAL ESQUERDO (SOLICITADO) -->
            <aside class="side-bar-left">
                <div class="side-tools">
                    <button id="btn-side-chart" class="side-btn active" title="Gráfico">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 3v18h18"></path>
                            <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"></path>
                        </svg>
                    </button>
                    <button id="btn-side-dashboard" class="side-btn" title="Painel">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="3" y1="9" x2="21" y2="9"></line>
                            <line x1="9" y1="21" x2="9" y2="9"></line>
                        </svg>
                    </button>
                </div>
            </aside>

            <!-- BARRA DE FERRAMENTAS FLUTUANTE (DE VOLTA AO LUGAR) -->
            <div class="toolbar-float">
                <button id="tool-cross" class="tool-btn" title="Cruz"><svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23"></line>
                        <line x1="1" y1="12" x2="23" y2="12"></line>
                    </svg></button>
                <button id="tool-hand" class="tool-btn" title="Mão"><svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 11V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v5M14 10V4a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v11M10 10.5V6a2 2 0 0 0-2-2v0a2 2 0 0 0-2 2v8M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15">
                        </path>
                    </svg></button>
                <button id="tool-zoom-in" class="tool-btn" title="Aumentar Zoom"><svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="12" y1="8" x2="12" y2="14"></line>
                        <line x1="9" y1="11" x2="15" y2="11"></line>
                    </svg></button>
                <button id="tool-zoom-out" class="tool-btn" title="Diminuir Zoom"><svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="9" y1="11" x2="15" y2="11"></line>
                    </svg></button>
                <button id="tool-settings" class="tool-btn" title="Configurações"><svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path
                            d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z">
                        </path>
                    </svg></button>
            </div>

            <!-- ÁREA DO GRÁFICO -->
            <div class="chart-layout" id="chart-view">
                <div class="chart-middle">
                    <canvas id="chart"></canvas>
                    <canvas id="price-scale"></canvas>
                </div>
            </div>

            <!-- ÁREA DO PAINEL (DASHBOARD) -->
            <div class="dashboard-layout" id="dashboard-view" style="display: none;">
                <div class="dashboard-container">
                    <h1>Painel Administrador</h1>
                    
                    <div class="admin-actions">
                        <button id="btn-admin-motor" class="admin-btn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path><line x1="12" y1="2" x2="12" y2="12"></line></svg>
                            Ligar Motor
                        </button>
                        <button id="btn-admin-clear" class="admin-btn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            Limpa Dados
                        </button>
                        <button id="btn-admin-mount" class="admin-btn">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h7"></path><polyline points="16 5 21 5 21 10"></polyline><line x1="9" y1="15" x2="21" y2="3"></line></svg>
                            Montar Grafico
                        </button>
                        <button id="btn-admin-exit" class="admin-btn danger">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            Encerra
                        </button>
                    </div>
                </div>
            </div>
        </main>

        <!-- RODAPÉ (BOTTOM BAR) -->
        <footer class="bottom-bar">
            <div class="footer-scales">
                <div class="horario-candle">
                    <canvas id="time-scale"></canvas>
                </div>
                <div class="data">
                    <canvas id="date-scale"></canvas>
                </div>
            </div>
            <div class="footer-right-box">
                <!-- Espaço para informações futuras, como status ou conexão -->
            </div>
        </footer>

        <!-- OVERLAY DE CARREGAMENTO (CORTINA) -->
        <div id="waiting-data" class="waiting-data">
            <div class="waiting-content">
                <div class="waiting-spinner"></div>
                <div class="waiting-text">AGUARDANDO DADOS...</div>
            </div>
        </div>

        <!-- MODAL DE CONFIRMAÇÃO PERSONALIZADO -->
        <div id="custom-confirm-modal" class="search-overlay"
            style="display: none; z-index: 10000; align-items: center; justify-content: center;">
            <div class="settings-box"
                style="width: 400px; height: auto; display: flex; flex-direction: column; background: rgba(28, 32, 39, 0.95); padding: 20px; border-radius: 8px;">
                <h3 style="color: #fff; margin-top: 0; margin-bottom: 15px; font-weight: normal; font-size: 16px;">
                    Confirmação</h3>
                <p id="custom-confirm-text"
                    style="color: #d1d4dc; font-size: 14px; margin-bottom: 25px; line-height: 1.5;"></p>
                <div style="display: flex; justify-content: flex-end; gap: 10px;">
                    <button id="custom-confirm-no"
                        style="background: rgba(255, 255, 255, 0.1); color: #d1d4dc; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">Cancelar</button>
                    <button id="custom-confirm-yes"
                        style="background: #2962ff; color: #fff; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">Confirmar</button>
                </div>
            </div>
        </div>

        <!-- LUPA DE PESQUISA (PASSO 5 ORIGINAL RESTAURADO) -->
        <div id="search-overlay" class="search-overlay">
            <div class="search-bar">
                <div class="search-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                </div>
                <input type="text" id="search-input" name="search-input" placeholder="Ativo ou Timeframe">

            </div>
        </div>

        <!-- MODAL DE CONFIGURAÇÕES -->
        <div id="settings-overlay" class="settings-overlay">
            <div class="settings-box">
                <aside class="settings-sidebar">
                    <div class="sidebar-header">
                        <h2>Configuração do Gráfico</h2>
                    </div>
                    <nav class="settings-nav">
                        <div class="nav-tab active" data-tab="geral">Geral</div>
                        <div class="nav-tab" data-tab="aparencia">Aparência</div>
                        <div class="nav-tab" data-tab="filtro">Filtro</div>
                        <div class="nav-tab" data-tab="atalhos">Atalhos</div>
                    </nav>
                </aside>

                <main class="settings-main">
                    <div class="main-header">
                        <h3 id="current-tab-title">Geral</h3>
                        <button id="close-settings" class="close-btn">&times;</button>
                    </div>
                    <div class="main-content">
                        <div id="content-geral" class="tab-content active">
                            <!-- SEÇÃO: CORES -->
                            <section class="settings-section">
                                <div class="section-header">
                                    <span>Cores</span>
                                    <div class="header-line"></div>
                                </div>
                                <div class="setting-grid">
                                    <div class="setting-item">
                                        <label for="input-chart-bg">Gráfico</label>
                                        <div class="custom-color-picker" id="picker-chart-bg" style="position:relative">
                                            <div class="color-preview" id="preview-chart-bg"
                                                style="background-color: #131722;"></div>
                                            <span class="color-value">Personalizada</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-chart-bg" name="input-chart-bg"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                    <div class="setting-item">
                                        <label for="input-theme-bg">Tema</label>
                                        <div class="custom-color-picker" id="picker-theme-bg" style="position:relative">
                                            <div class="color-preview" id="preview-theme-bg"
                                                style="background-color: #1c2027;"></div>
                                            <span class="color-value">Padrão</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-theme-bg" name="input-theme-bg"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- SEÇÃO: ESCALAS -->
                            <section class="settings-section">
                                <div class="section-header">
                                    <span>Escalas</span>
                                    <div class="header-line"></div>
                                </div>
                                <div class="setting-grid">
                                    <div class="setting-item">
                                        <label for="input-font-size">Tamanho Fonte</label>
                                        <input type="number" id="input-font-size" name="input-font-size"
                                            class="custom-input" value="12" min="8" max="20">

                                    </div>
                                    <div class="setting-item">
                                        <label for="input-font-color">Cor Fonte</label>
                                        <div class="custom-color-picker" id="picker-font-color"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-font-color"
                                                style="background-color: #787b86;"></div>
                                            <span class="color-value">Cinza</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-font-color" name="input-font-color"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <div id="content-aparencia" class="tab-content">
                            <!-- SEÇÃO: CORES DO FOOTPRINT -->
                            <section class="settings-section">
                                <div class="section-header">
                                    <span>Footprint & Preço</span>
                                    <div class="header-line"></div>
                                </div>
                                <div class="setting-grid">
                                    <!-- LINHA 1: SALDOS -->
                                    <div class="setting-item">
                                        <label for="input-pos-color">Saldo Positivo</label>
                                        <div class="custom-color-picker" id="picker-pos-color"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-pos-color"
                                                style="background-color: #089981;"></div>
                                            <span class="color-value">Verde</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-pos-color" name="input-pos-color"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                    <div class="setting-item">
                                        <label for="input-neg-color">Saldo Negativo</label>
                                        <div class="custom-color-picker" id="picker-neg-color"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-neg-color"
                                                style="background-color: #f23645;"></div>
                                            <span class="color-value">Vermelho</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-neg-color" name="input-neg-color"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>

                                    <!-- LINHA 2: CONTORNOS -->
                                    <div class="setting-item">
                                        <label for="input-pos-outline">Contorno Positivo</label>
                                        <div class="custom-color-picker" id="picker-pos-outline"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-pos-outline"
                                                style="background-color: #089981;"></div>
                                            <span class="color-value">Auto</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-pos-outline" name="input-pos-outline"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                    <div class="setting-item">
                                        <label for="input-neg-outline">Contorno Negativo</label>
                                        <div class="custom-color-picker" id="picker-neg-outline"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-neg-outline"
                                                style="background-color: #f23645;"></div>
                                            <span class="color-value">Auto</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-neg-outline" name="input-neg-outline"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>

                                    <!-- LINHA 3: QUANTIDADES -->
                                    <div class="setting-item">
                                        <label for="input-footprint-bg">Fundo Quantidade</label>
                                        <div class="custom-color-picker" id="picker-footprint-bg"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-footprint-bg"
                                                style="background-color: rgba(255,255,255,0.03);"></div>
                                            <span class="color-value">Auto</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-footprint-bg" name="input-footprint-bg"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                    <div class="setting-item">
                                        <label for="input-footprint-font-color">Fonte Quantidade</label>
                                        <div class="custom-color-picker" id="picker-footprint-font"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-footprint-font"
                                                style="background-color: #ffffff;"></div>
                                            <span class="color-value">Branco</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-footprint-font-color"
                                                name="input-footprint-font-color"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>

                                    <!-- LINHA 4: PREÇO ATUAL -->
                                    <div class="setting-item">
                                        <label for="input-last-price-bg">Fundo Preço Atual</label>
                                        <div class="custom-color-picker" id="picker-last-price-bg"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-last-price-bg"
                                                style="background-color: #ff9800;"></div>
                                            <span class="color-value">Laranja</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-last-price-bg" name="input-last-price-bg"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                    <div class="setting-item">
                                        <label for="input-last-price-line">Linha Preço Atual</label>
                                        <div class="custom-color-picker" id="picker-last-price-line"
                                            style="position:relative">
                                            <div class="color-preview" id="preview-last-price-line"
                                                style="background-color: #ff9800;"></div>
                                            <span class="color-value">Laranja</span>
                                            <svg class="dropdown-arrow" viewBox="0 0 24 24" fill="none"
                                                stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                stroke-linejoin="round">
                                                <polyline points="6 9 12 15 18 9"></polyline>
                                            </svg>
                                            <input type="color" id="input-last-price-line" name="input-last-price-line"
                                                style="position:absolute; opacity:0; width:100%; height:100%; top:0; left:0; cursor:pointer;">

                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>

                        <!-- ABA FILTRO (PASSO 7 - DINÂMICO) -->
                        <div id="content-filtro" class="tab-content">
                            <section class="settings-section">
                                <div class="section-header">
                                    <span>Filtros de Fluxo</span>
                                    <div class="header-line"></div>
                                </div>
                                <div id="filter-container">
                                    <!-- Filtros serão inseridos aqui via JS -->
                                </div>
                                <button id="add-filter-btn" class="settings-btn secondary"
                                    style="margin-top: 10px; width: 100%; border: 1px dashed rgba(255,255,255,0.6); background: transparent; color: #ffffff; opacity: 0.9;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                        style="margin-right: 8px;">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    Adicionar Filtro
                                </button>
                            </section>
                        </div>

                        <!-- ABA ATALHOS -->
                        <div id="content-atalhos" class="tab-content">
                            <!-- SEÇÃO: FERRAMENTAS -->
                            <section class="settings-section">
                                <div class="section-header">
                                    <span>Ferramentas</span>
                                    <div class="header-line"></div>
                                </div>
                                <div class="setting-grid">
                                    <div class="setting-item">
                                        <label for="shortcut-hand">Ferramenta Mão</label>
                                        <input type="text" id="shortcut-hand" class="shortcut-input" readonly
                                            placeholder="Pressione uma tecla">
                                    </div>
                                    <div class="setting-item">
                                        <label for="shortcut-cross">Ferramenta Cruz</label>
                                        <input type="text" id="shortcut-cross" class="shortcut-input" readonly
                                            placeholder="Pressione uma tecla">
                                    </div>
                                </div>
                            </section>

                            <!-- SEÇÃO: NAVEGAÇÃO -->
                            <section class="settings-section">
                                <div class="section-header">
                                    <span>Navegação & Zoom</span>
                                    <div class="header-line"></div>
                                </div>
                                <div class="setting-grid">
                                    <div class="setting-item">
                                        <label for="shortcut-zoom-in">Aumentar Zoom (+)</label>
                                        <input type="text" id="shortcut-zoom-in" class="shortcut-input" readonly
                                            placeholder="Pressione uma tecla">
                                    </div>
                                    <div class="setting-item">
                                        <label for="shortcut-zoom-out">Diminuir Zoom (-)</label>
                                        <input type="text" id="shortcut-zoom-out" class="shortcut-input" readonly
                                            placeholder="Pressione uma tecla">
                                    </div>
                                </div>
                            </section>

                            <!-- SEÇÃO: SISTEMA -->
                            <section class="settings-section">
                                <div class="section-header">
                                    <span>Sistema</span>
                                    <div class="header-line"></div>
                                </div>
                                <div class="setting-grid">
                                    <div class="setting-item">
                                        <label for="shortcut-motor">Ligar/Desligar Motor</label>
                                        <input type="text" id="shortcut-motor" class="shortcut-input" readonly
                                            placeholder="Pressione uma tecla">
                                    </div>
                                    <div class="setting-item">
                                        <label for="shortcut-reset">Limpar Tudo (Reset)</label>
                                        <input type="text" id="shortcut-reset" class="shortcut-input" readonly
                                            placeholder="Pressione uma tecla">
                                    </div>
                                    <div class="setting-item">
                                        <label for="shortcut-shutdown">Desligar Terminal</label>
                                        <input type="text" id="shortcut-shutdown" class="shortcut-input" readonly
                                            placeholder="Pressione uma tecla">
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>
                    <footer class="settings-footer">
                        <button id="cancel-settings" class="footer-btn cancel">Cancelar</button>
                        <button id="confirm-settings" class="footer-btn confirm">Confirmar</button>
                    </footer>
                </main>
            </div>
        </div>

        <!-- POPUP DE INFORMAÇÃO DO CANDLE (PASSO 10) -->
        <div id="candle-tooltip" class="candle-tooltip">
            <div class="tooltip-header" id="tt-header">Resumo de --/--</div>
            <div class="tooltip-grid">
                <div class="tt-row"><span class="tt-label">Abertura</span><span id="tt-open"
                        class="tt-val-white">0.00</span></div>
                <div class="tt-row"><span class="tt-label">Máxima</span><span id="tt-high"
                        class="tt-val-green">0.00</span>
                </div>
                <div class="tt-row"><span class="tt-label">Mínima</span><span id="tt-low" class="tt-val-red">0.00</span>
                </div>
                <div class="tt-row"><span class="tt-label">Fechamento</span><span id="tt-close"
                        class="tt-val-blue">0.00</span></div>
                <div class="tt-row"
                    style="margin-top:4px; border-top:1px solid rgba(255,255,255,0.1); padding-top:6px;">
                    <span class="tt-label">Range</span><span id="tt-range" class="tt-val-range">0.00</span>
                </div>
            </div>
        </div>


        <!-- OVERLAY DE DESLIGAMENTO -->
        <div id="shutdown-overlay" class="shutdown-overlay">
            <div class="shutdown-content">
                <div class="shutdown-logo">ZENITH</div>
                <div class="shutdown-text">TERMINAL DESLIGANDO...</div>
                <div class="shutdown-sub">Encerrando conexões e salvando cache...</div>
            </div>
        </div>

        <script src="script.js?v=8.9.4"></script>
</body>

</html>